# Base URL for duffleup-api, INCLUDING the /api/v1 prefix. The typed API client
# (src/lib/api) and EarlyAccessForm both pass resource-relative paths under it
# (e.g. /mood-config). Live data (SSR fetches) needs a local backend running,
# or point this at prod: https://api.duffleup.in/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Pre-launch site gate (src/middleware.ts). Server-only — never prefix these
# with NEXT_PUBLIC_, or the password ships to the browser. The gate is closed
# unless SITE_GATE_ENABLED is exactly "false", so leaving these unset locally
# means every request gets a Basic Auth prompt with no password that satisfies
# it. Set both to work on the site locally; set SITE_GATE_ENABLED=false to
# lift the gate at launch without a code change.
SITE_GATE_PASSWORD=choose-a-local-password
SITE_GATE_ENABLED=true
